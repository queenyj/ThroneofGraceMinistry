---
import Site from '../layouts/Site.astro';
---
<Site title="Home" description="A place to worship, grow in faith, and draw near to God." home>
  <section class="hero">
    <div class="wrap hero-inner">
      <div class="hero-copy">
        <p class="eyebrow">Welcome to Throne of Grace Ministry</p>
        <h1>Draw near<br />to God.</h1>
        <p class="lead">A place to worship, grow in faith, and find hope in Jesus Christ.</p>
        <a class="button" href="/about-god/">Get to know God</a>
      </div>
      <figure class="hero-scripture">
        <span aria-hidden="true">“</span>
        <blockquote>Let us therefore come boldly to the throne of grace, that we may obtain mercy and find grace to help in time of need.</blockquote>
        <figcaption>Hebrews 4:16 · NKJV</figcaption>
      </figure>
    </div>
  </section>
  <section class="wrap section">
    <h2>Take a step in faith</h2>
    <div class="cards">
      <article><h3>Praise</h3><p>Make room for worship and give thanks to God in the middle of your day.</p><a href="/praise/">Explore praise</a></article>
      <article><h3>About God</h3><p>Read what Scripture says about God’s character, grace, and love.</p><a href="/about-god/">Explore Scripture</a></article>
      <article><h3>Contact</h3><p>Find out how to reach the ministry with questions or prayer requests.</p><a href="/contact/">Contact the ministry</a></article>
    </div>
  </section>
</Site>
