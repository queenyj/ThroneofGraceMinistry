---
import Site from '../layouts/Site.astro';
---
<Site title="Praise" description="Scripture and a simple way to begin a moment of praise.">
  <section class="page-intro"><div class="wrap">
    <h1>Praise</h1>
    <p class="lead">Pause, remember God’s goodness, and give him thanks.</p>
  </div></section>
  <section class="wrap section reading">
    <figure class="scripture">
      <blockquote>Let everything that has breath praise the LORD. Praise the LORD!</blockquote>
      <figcaption>Psalm 150:6 · NKJV</figcaption>
    </figure>
    <h2>A moment of worship</h2>
    <ol>
      <li>Read Psalm 150 aloud and take a moment to reflect on it.</li>
      <li>Name one thing you are grateful for today and thank God for it.</li>
      <li>Sing a familiar hymn or tell God in your own words what you love about him.</li>
    </ol>
    <a class="text-link" href="/praise/exceedingly-great-reward/">Exceedingly great reward</a>
  </section>
</Site>
